#include <stdio.h>

int main() {
    int arr[10], i, n, search, found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d values:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &search);

    for(i = 0; i < n; i++) {
        if(arr[i] == search) {
            printf("Element %d found at position %d\n", search, i+1);
            found = 1;
            break;
        }
    }

    if(found == 0) {
        printf("Element %d not found\n", search);
    }

    return 0;
}

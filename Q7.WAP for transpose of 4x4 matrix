#include <stdio.h>

int main() {
    int a[4][4], trans[4][4];
    int i, j;

    printf("Enter elements of 4x4 matrix:\n");
    for(i = 0; i < 4; i++) {
        for(j = 0; j < 4; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Find transpose
    for(i = 0; i < 4; i++) {
        for(j = 0; j < 4; j++) {
            trans[j][i] = a[i][j];
        }
    }

    printf("Transpose of matrix is:\n");
    for(i = 0; i < 4; i++) {
        for(j = 0; j < 4; j++) {
            printf("%d ", trans[i][j]);
        }
        printf("\n");
    }

    return 0;
}

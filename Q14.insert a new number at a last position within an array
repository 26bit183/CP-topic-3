#include <stdio.h>

int main() {
    int arr[100];
    int n, i, newNum;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d values:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter new number to insert at last: ");
    scanf("%d", &newNum);

    arr[n] = newNum;
    n++;

    printf("Array after insertion:\n");
    for(i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}

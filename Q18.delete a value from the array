#include <stdio.h>

int main() {
    int arr[100];
    int n, i, val, pos = -1;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d values:\n", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter value to delete: ");
    scanf("%d", &val);

    // Find position of value
    for(i = 0; i < n; i++) {
        if(arr[i] == val) {
            pos = i;
            break;
        }
    }

    if(pos == -1) {
        printf("Value %d not found\n", val);
    } else {
        for(i = pos; i < n-1; i++) {
            arr[i] = arr[i+1];
        }
        n--;

        printf("Array after deletion:\n");
        for(i = 0; i < n; i++) {
            printf("%d ", arr[i]);
        }
    }

    return 0;
}
